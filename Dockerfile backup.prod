# 1. Use official Node.js LTS image
FROM node:24.3-alpine AS builder

# Install pnpm globally
RUN npm install -g pnpm

# 2. Set working directory
WORKDIR /app

# 3. Copy package files and install dependencies
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# 4. Copy the rest of the app and build
COPY . .
COPY ./.env.local ./
RUN pnpm build

# 5. Production image, copy only necessary files
FROM node:24.3-alpine AS runner
WORKDIR /app

# Install pnpm globally in runner stage too
RUN npm install -g pnpm

# Only copy production node_modules and build output
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules

# Copy Next.js and TypeScript configs
COPY --from=builder /app/next.config.js ./
COPY --from=builder /app/next-env.d.ts ./
COPY --from=builder /app/tsconfig.json ./

# Copy Tailwind v4 and PostCSS configs
COPY --from=builder /app/tailwind.config.js ./
COPY --from=builder /app/postcss.config.js ./

# Copy shadcn/ui config
COPY --from=builder /app/components.json ./

# Copy source directories
COPY --from=builder /app/styles ./styles
COPY --from=builder /app/components ./components
COPY --from=builder /app/lib ./lib
COPY --from=builder /app/pages ./pages

# Copy environment variables for runtime
COPY --from=builder /app/.env.local ./.env.production

# 6. Expose port and start
EXPOSE 3000
ENV NODE_ENV=production

CMD ["pnpm", "start"]
